{
  "name": "usman-stationary",
  "version": "1.0.0",
  "private": true,
  "description": "Distribution, inventory and accounts for Usman Stationary",
  "author": "Usman Stationary",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.js",
    "desktop": "electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "ui:check": "node scripts/ui-check.cjs",
    "desktop:check": "node scripts/desktop-check.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "bwip-js": "^4.8.0",
    "electron-updater": "^6.8.11",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "com.aleemcore.usmanstationary",
    "productName": "Usman Stationary",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Aleem33",
        "repo": "Usman-Stationary"
      }
    ],
    "artifactName": "Usman-Stationary-Setup-${version}.${ext}"
  }
}
